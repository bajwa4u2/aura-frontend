+/// Which track KINDS a peer is missing and must therefore be given.
+///
+/// Compared by KIND, never by track identity: a peer already sending video is
+/// satisfied even if it is a different track (a switched device, or a screen
+/// share standing in for the camera). Re-adding would create a duplicate
+/// m-line and a pointless renegotiation on every ordinary join.
+Set<String> missingSenderKinds({
+  required Set<String> presentKinds,
+  required List<String> localKinds,
+}) {
+  return localKinds
+      .where((k) => k.isNotEmpty && !presentKinds.contains(k))
+      .toSet();
+}
+
+/// Why a peer may or may not be repaired. Named outcomes rather than a bool so
+/// the log says WHICH guard held, and so the tests pin each one separately.
+enum PeerRepairVerdict {
+  /// Genuinely stale: negotiation finished, media exists, senders are missing.
+  repair,
+
+  /// Nothing to publish yet — local acquisition has not completed.
+  waitMedia,
+
+  /// The answerer has not applied the remote offer yet. Its zero senders are
+  /// CORRECT for this instant; `handleRemoteOffer` attaches them next.
+  waitRemoteDescription,
+
+  /// An offer/answer exchange is mid-flight. Touching senders now is what
+  /// misaligns m-lines.
+  waitNegotiation,
+
+  /// Already publishing everything it should.
+  healthy,
+}
+
+/// Decide whether a peer's missing senders are a DEFECT or a normal transient.
+///
+/// ───────────────────────────────────────────────────────────────────────────
+/// This function exists because the previous repair (381c452, reverted) used
+///
+///     peer has zero senders  ⇒  peer is broken
+///
+/// which is false. It broke live meetings by adding tracks to answerers that
+/// were simply not finished yet. "Zero senders" is a state BOTH a broken peer
+/// and a healthy mid-negotiation peer pass through, and nothing downstream can
+/// recover from confusing them.
+///
+/// The guards below are derived from the two real lifecycles, not assumed:
+///
+/// ANSWERER (`handleRemoteOffer`)
+///   1. `_ensurePeer(addLocalTracks: false)` — zero senders, and CORRECT.
+///      `remoteDescriptionSet` is false here → `waitRemoteDescription`.
+///   2. `setRemoteDescription(offer)` → signalling `have-remote-offer`.
+///      `remoteDescriptionSet` is now true, so guard 1 has stopped helping —
+///      but the state is not stable → `waitNegotiation`.
+///   3. `_attachLocalTracks` — where the defect happens if media is late.
+///   4. `setLocalDescription(answer)` → stable. Missing senders here are REAL.
+///
+/// OFFERER (`createOfferFor`)
+///   1. `_ensurePeer(addLocalTracks: true)` — attaches immediately, or attaches
+///      nothing if media is late.
+///   2. `_makingOffer = true`, then `await createOffer()`. Signalling is STILL
+///      stable during this await, so `signallingStable` alone would wrongly
+///      admit it. This is precisely why `makingOffer` is a required guard and
+///      not redundant.
+///   3. `setLocalDescription(offer)` → `have-local-offer`, not stable.
+///   4. remote answer applied → stable. Missing senders here are REAL.
+///
+/// So the two windows in which zero senders are legitimate are covered by
+/// `remoteDescriptionSet`, `signallingStable` and `makingOffer` TOGETHER. Any
+/// one of them alone lets a healthy peer through.
+PeerRepairVerdict evaluatePeerRepair({
+  required bool localMediaReady,
+  required bool remoteDescriptionSet,
+  required bool signallingStable,
+  required bool makingOffer,
+  required Set<String> presentKinds,
+  required List<String> localKinds,
+}) {
+  // Order matters only for which reason is reported; the guards are ANDed.
+  if (!localMediaReady) return PeerRepairVerdict.waitMedia;
+  if (!remoteDescriptionSet) return PeerRepairVerdict.waitRemoteDescription;
+  if (makingOffer || !signallingStable) return PeerRepairVerdict.waitNegotiation;
+  if (missingSenderKinds(presentKinds: presentKinds, localKinds: localKinds)
+      .isEmpty) {
+    return PeerRepairVerdict.healthy;
+  }
+  return PeerRepairVerdict.repair;
+}
