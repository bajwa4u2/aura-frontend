<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Audio recording (record package, WebRTC voice calls) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Camera (image_picker, WebRTC video calls) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Bluetooth audio routing for calls. Without BLUETOOTH_CONNECT on
      Android 12+ (API 31) the app cannot route call audio to a paired headset
      or read its name, so a person wearing earbuds hears the call on the
      speaker with no explanation. `neverForLocation` because Aura does not
      derive location from Bluetooth and must not appear to.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation" />

    <!--
      NO FOREGROUND SERVICE PERMISSIONS, BECAUSE THERE IS NO FOREGROUND SERVICE.
      ─────────────────────────────────────────────────────────────────────────
      This block used to declare FOREGROUND_SERVICE, FOREGROUND_SERVICE_CAMERA
      and FOREGROUND_SERVICE_MICROPHONE, with a comment saying they keep a
      backgrounded call's capture alive. They do not, and never did. A
      permission grants nothing on its own: capture survives backgrounding only
      if the app actually starts a foreground service of that type, and Aura
      starts none. The merged release manifest carries no <service> of ours, no
      android:foregroundServiceType anywhere, and no plugin contributes either;
      there is no startForeground call in the app. The permissions were inert.

      They were added 2026-08-25 (33ae22d), AFTER the released 1.3.0 build
      (version code 24), which shipped without them. Their only observable
      effect was to make Google Play demand a foreground-service declaration
      naming a task the app does not perform — and Play is explicit that
      "you can only use foreground services if your app performs tasks
      noticeable to the user when they're not directly interacting with your
      app." Answering it would have been a false declaration; the honest fix is
      to stop asking for what we do not use.

      If a backgrounded call ever needs to keep capturing, the work is a real
      foreground service with the matching type — a feature, implemented and
      proven — and these permissions come back WITH it, not before it.
    -->

    <!-- Keeps the connection alive while the screen is off during a call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      An incoming call must be able to present itself AS A CALL — full screen,
      over the lock screen — instead of as a notification that a person can
      miss and thereby bury a live call (founder ruling 2026-08-25).

      Android 14 (API 34) stopped granting this at install to every app that
      asks. Aura declares it as a calling app; where it is not granted, the
      call degrades to a heads-up notification and the RING is unaffected,
      because the ring is no longer a property of the notification. See
      IncomingCallPresenter and MainActivity.canUseFullScreenIntent.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Camera is optional: app works on camera-less devices -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:label="Aura"
        android:name=".AuraApplication"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Theme visible while Flutter initializes -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Custom URL scheme so external links of the form aura://...
              wake the app and route through `app_links` /
              communication_resolver. Works without domain verification.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aura" />
            </intent-filter>

            <!--
              HTTPS App Links for auraplatform.org. android:autoVerify="true"
              tells Android to fetch /.well-known/assetlinks.json from the
              host at install time; on success the app handles links to
              these hosts without an "Open with" dialog.

              The assetlinks.json template lives at
              aura_final/web/.well-known/assetlinks.json — operator must
              replace the placeholder SHA-256 fingerprint with the real
              upload+release certificate fingerprints before submitting
              to Play Store.
            -->
            <!--
              APP LINKS - SCOPED TO PUBLIC ELIGIBILITY.

              This filter used to declare the two hosts with NO path data,
              which claims EVERY url on them. Two consequences, both live:
              private member surfaces were associated to the app, and because
              Flutter deep linking was not enabled either, every claimed link
              opened Aura at home. Association validated perfectly while the
              product lost the destination on every share.

              The paths below are the eligible set from
              contracts/native_continuation_contract.json - the same authority
              the AASA and the in-app resolver read. Android has no negative
              matching, so the contract's exclusions (post editors, authoring
              paths, member shells) are enforced in-app by route
              classification, which fails closed.

              Multiple <data> elements combine as a cross product: every
              scheme x host x path listed here matches.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="auraplatform.org" />
                <data android:host="app.auraplatform.org" />

                <!-- The canonical public share family. -->
                <data android:pathPrefix="/p/" />

                <!-- Public destinations those share urls resolve to. -->
                <data android:pathPrefix="/posts/" />
                <data android:pathPrefix="/announcements/" />
                <data android:pathPrefix="/articles/" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/author/" />
                <data android:pathPrefix="/institutions/" />
                <data android:pathPrefix="/spaces/" />

                <!-- Guest-reachable meeting entry. -->
                <data android:pathPrefix="/meetings/join/" />

                <!-- Invitation + auth ceremonies that complete a destination. -->
                <data android:pathPrefix="/invite/" />
                <data android:pathPrefix="/auth/" />
                <data android:path="/verify-email" />
                <data android:path="/reset-password" />
                <data android:path="/forgot-password" />
                <data android:path="/account-deletion" />
            </intent-filter>

            <!--
              SHARE INTO AURA — the operating system's share sheet.

              EVERY TYPE IS ENUMERATED, and none is a wildcard. `image/*` would
              put Aura in the share sheet for SVG, which the backend rejects at
              five separate gates; `*/*` would put it there for everything and
              turn most shares into a refusal a person cannot have predicted.
              An app that appears in the sheet is making a promise, so the list
              below is exactly what intake accepts and is held to that by
              `test/doctrine/android_share_target_gate_test.dart`.

              text/plain is what a browser sends when someone shares a link.

              This filter names no destination and grants no authority. The
              intent arrives with a read grant scoped to itself, and everything
              after that happens inside Aura, on `/share/incoming`, with the
              person choosing.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <!-- images. SVG is absent deliberately: the backend rejects it across five
                   gates as a P0-7 measure, so offering Aura for it would be an
                   invitation to a refusal. HEIC and HEIF ARE offered — intake
                   re-encodes them to something every recipient can render. -->
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <!-- video -->
                <data android:mimeType="video/mp4" />
                <data android:mimeType="video/quicktime" />
                <data android:mimeType="video/webm" />
                <!-- audio -->
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/aac" />
                <data android:mimeType="audio/ogg" />
                <data android:mimeType="audio/webm" />
                <data android:mimeType="audio/wav" />
                <data android:mimeType="audio/x-wav" />
                <data android:mimeType="audio/flac" />
                <data android:mimeType="audio/mp3" />
                <data android:mimeType="audio/m4a" />
                <data android:mimeType="audio/x-aac" />
                <!-- documents -->
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>

            <!--
              A share sheet can hand over several items at once, and refusing
              the second is not something a person would forgive.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- images. SVG is absent deliberately: the backend rejects it across five
                   gates as a P0-7 measure, so offering Aura for it would be an
                   invitation to a refusal. HEIC and HEIF ARE offered — intake
                   re-encodes them to something every recipient can render. -->
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <!-- video -->
                <data android:mimeType="video/mp4" />
                <data android:mimeType="video/quicktime" />
                <data android:mimeType="video/webm" />
                <!-- audio -->
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/aac" />
                <data android:mimeType="audio/ogg" />
                <data android:mimeType="audio/webm" />
                <data android:mimeType="audio/wav" />
                <data android:mimeType="audio/x-wav" />
                <data android:mimeType="audio/flac" />
                <data android:mimeType="audio/mp3" />
                <data android:mimeType="audio/m4a" />
                <data android:mimeType="audio/x-aac" />
                <!-- documents -->
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>

            <!--
              FLUTTER READS THIS FROM THE ACTIVITY, AND ONLY FROM THE ACTIVITY.
              ─────────────────────────────────────────────────────────────────
              It sat inside the <receiver> below until 2026-09-04, where neither
              reader could see it: `FlutterActivity.shouldHandleDeeplinking()`
              reads `getActivityInfo(getComponentName(), GET_META_DATA)
              .metaData`, and the Gradle app-link tooling walks <activity>
              children only (DeepLinkJsonFromManifestTaskHelper).

              WHAT THAT DID AND DID NOT COST, disassembled rather than assumed.
              `FlutterActivityLaunchConfigs.deepLinkEnabled` returns TRUE when
              the key is absent, so deep linking was on the whole time and
              continuation was not broken — the comment that sat beside the
              misplaced line overstated its own importance. What it did cost is
              real but quieter: `outputAppLinkSettings` reported
              deeplinkingFlagEnabled=false, so the build tooling and the deep
              link validator described this app's configuration wrongly. And a
              declaration nothing reads is a trap: it would have failed to
              disable anything the day someone needed it to, and it would fail
              to enable anything the day the default changes.
            -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />

        </activity>

        <!-- Flutter engine registration -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          INCOMING CALL PRESENTATION (2026-08-25).

          Sits ALONGSIDE the firebase_messaging plugin's own receiver on the
          same broadcast — a broadcast reaches every registered receiver — so
          Dart continues to receive every message it received before. It is
          deliberately NOT a FirebaseMessagingService: FCM binds only one, and
          the plugin already owns it. See AuraCallPushReceiver.
        -->
        <receiver
            android:name=".AuraCallPushReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <!--
              Ordered broadcast: an explicit priority so call presentation is
              never left to undefined ordering against the other receivers
              registered for this action.
            -->
            <intent-filter android:priority="999">
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>

        </receiver>

        <!-- Default FCM channel for incoming-call ringing. Channel itself is
             created at process start in AuraApplication.onCreate(). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="aura_calls" />

    </application>

    <!-- Required for text processing plugins -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>