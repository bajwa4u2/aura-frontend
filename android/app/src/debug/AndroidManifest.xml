<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- CERTIFICATION-ONLY. DEBUG SOURCE SET.

         Points the debug build at a network security config that permits
         cleartext to the local certification backend ONLY — loopback via
         `adb reverse`, plus the development host as a fallback. Everything
         else stays cleartext-forbidden, including all of Aura's real hosts.

         This override is confined to src/debug/ by construction. A release
         build never merges this manifest, so the exception cannot ship. That
         is verified after every certification build by inspecting the merged
         RELEASE manifest and asserting the attribute is absent.

         tools:replace is required because the main manifest's <application>
         does not declare networkSecurityConfig; without it the merger treats
         the addition as a conflict rather than an override. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
